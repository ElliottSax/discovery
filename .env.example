# Production Environment Configuration Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# ===========================
# Application Settings
# ===========================
APP_NAME=politician-trading-analysis
APP_ENV=production  # development, staging, production
APP_DEBUG=false
APP_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===========================
# Database Configuration (REQUIRED)
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quant_db
DB_USER=quant_user
DB_PASSWORD=  # REQUIRED: Set strong password

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Read replica (optional, for read-heavy queries)
DB_READ_HOST=
DB_READ_PORT=5432

# ===========================
# MLFlow Configuration
# ===========================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=politician_trading_analysis
MLFLOW_ARTIFACT_LOCATION=/data/mlflow/artifacts
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:CHANGE_ME@localhost:5432/mlflow_db

# ===========================
# Redis Configuration (Optional)
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ===========================
# Celery Configuration (Optional)
# ===========================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=3600

# ===========================
# API Configuration (Optional)
# ===========================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# CORS Settings
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================
# Security
# ===========================
SECRET_KEY=  # REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET_KEY=  # REQUIRED: Generate with: openssl rand -hex 32

# ===========================
# Monitoring (Optional)
# ===========================
SENTRY_DSN=
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# ===========================
# Cache Configuration
# ===========================
CACHE_DIR=./cache
CACHE_MAX_SIZE_MB=500
CACHE_TTL_SECONDS=3600

# ===========================
# Logging Configuration
# ===========================
LOG_LEVEL=INFO
LOG_FILE=production.log
LOG_FORMAT=json  # json or text
LOG_ROTATION=daily

# ===========================
# Backup Configuration
# ===========================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# ===========================
# Email Notifications (Optional)
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=admin@yourdomain.com

# ===========================
# Resource Limits
# ===========================
MAX_MEMORY_MB=4096
MAX_CPU_PERCENT=80

# ===========================
# Feature Flags
# ===========================
ENABLE_AUTO_RETRAINING=true
ENABLE_CACHING=true
